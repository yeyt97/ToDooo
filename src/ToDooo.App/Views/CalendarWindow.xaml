<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ToDooo.Views.CalendarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="Transparent"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderBar"
            Padding="14,0,10,0"
            Background="Transparent"
            ColumnSpacing="8"
            PointerCaptureLost="HeaderBar_PointerCaptureLost"
            PointerMoved="HeaderBar_PointerMoved"
            PointerPressed="HeaderBar_PointerPressed"
            PointerReleased="HeaderBar_PointerReleased">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border
                    Width="22"
                    Height="22"
                    CornerRadius="7"
                    Background="{ThemeResource LayerFillSecondaryBrush}"
                    BorderBrush="{ThemeResource LayerStrokeBrush}"
                    BorderThickness="1">
                    <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
                <TextBlock
                    x:Name="HeaderTitleText"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Text="日历" />
            </StackPanel>

            <Border
                x:Name="MonthNavBar"
                Grid.Column="1"
                Margin="6,0,0,0"
                Padding="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource SegmentBarBrush}"
                BorderBrush="{ThemeResource LayerStrokeBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                    <Button
                        Width="26"
                        Height="26"
                        AutomationProperties.Name="上个月"
                        AllowDrop="True"
                        Click="PrevMonth_Click"
                        DragLeave="MonthNav_DragLeave"
                        DragOver="PrevMonth_DragOver"
                        Style="{StaticResource FlatIconButtonStyle}">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    </Button>
                    <Button
                        x:Name="MonthTitleButton"
                        Height="26"
                        Padding="6,0"
                        AutomationProperties.Name="选择年月"
                        Click="MonthTitle_Click"
                        Style="{StaticResource LinkButtonStyle}">
                        <TextBlock
                            x:Name="MonthTitle"
                            MinWidth="88"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            Foreground="{ThemeResource TextPrimaryBrush}" />
                    </Button>
                    <Button
                        Width="26"
                        Height="26"
                        AutomationProperties.Name="下个月"
                        AllowDrop="True"
                        Click="NextMonth_Click"
                        DragLeave="MonthNav_DragLeave"
                        DragOver="NextMonth_DragOver"
                        Style="{StaticResource FlatIconButtonStyle}">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                    <Button
                        Height="26"
                        Padding="8,0"
                        AutomationProperties.Name="回到今天"
                        Click="Today_Click"
                        Style="{StaticResource LinkButtonStyle}"
                        Content="今天" />
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="RightPanelToggleButton"
                    AutomationProperties.Name="收起详情"
                    Click="RightPanelToggle_Click"
                    Foreground="{ThemeResource AccentBrush}"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <FontIcon x:Name="RightPanelToggleIcon" Glyph="&#xE90D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="12,0,10,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="260" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="8"
                Background="{ThemeResource LayerFillSecondaryBrush}"
                BorderBrush="{ThemeResource LayerStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Background="Transparent" PointerWheelChanged="MonthGrid_PointerWheelChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="WeekdayRow" Margin="0,0,0,6" />
                    <Grid
                        x:Name="DaysGrid"
                        Grid.Row="1"
                        RowSpacing="4"
                        ColumnSpacing="4" />
                </Grid>
            </Border>

            <Grid x:Name="RightDrawerHost" Grid.Column="1" Margin="10,0,0,0">
            <Grid x:Name="RightPanelGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SelectedDayRow" Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="UndatedRow" Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Padding="10,8,10,8"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock
                                x:Name="SelectedDateText"
                                Margin="0,0,30,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}" />
                            <Button
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="在此日期新建任务"
                                Click="NewTask_Click"
                                Style="{StaticResource FlatIconButtonStyle}">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailsPanel" Padding="0,0,10,0" Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid
                    x:Name="RightSplitHandle"
                    Grid.Row="1"
                    Height="10"
                    Background="Transparent"
                    PointerCaptureLost="RightSplitHandle_PointerCaptureLost"
                    PointerEntered="RightSplitHandle_PointerEntered"
                    PointerExited="RightSplitHandle_PointerExited"
                    PointerMoved="RightSplitHandle_PointerMoved"
                    PointerPressed="RightSplitHandle_PointerPressed"
                    PointerReleased="RightSplitHandle_PointerReleased">
                    <Border
                        Width="32"
                        Height="3"
                        CornerRadius="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource LayerStrokeBrush}" />
                </Grid>

                <Border
                    x:Name="UndatedDropZone"
                    Grid.Row="2"
                    Padding="10,8,10,8"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    AllowDrop="True"
                    DragOver="UndatedDropZone_DragOver"
                    DragLeave="UndatedDropZone_DragLeave"
                    Drop="UndatedDropZone_Drop">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="UndatedHeaderText"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="无截止日期" />
                            <Border
                                Grid.Column="1"
                                Padding="6,1,6,1"
                                Background="{ThemeResource LayerFillSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    x:Name="UndatedCountText"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextMutedBrush}" />
                            </Border>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="UndatedPanel" Padding="0,0,10,0" Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
