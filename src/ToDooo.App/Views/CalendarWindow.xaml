<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ToDooo.Views.CalendarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="Transparent"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderBar"
            Padding="14,0,10,0"
            Background="Transparent"
            ColumnSpacing="8"
            PointerCaptureLost="HeaderBar_PointerCaptureLost"
            PointerMoved="HeaderBar_PointerMoved"
            PointerPressed="HeaderBar_PointerPressed"
            PointerReleased="HeaderBar_PointerReleased">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  左侧：侧栏开关、筛选  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="RightPanelToggleButton"
                    AutomationProperties.Name="收起详情"
                    Click="RightPanelToggle_Click"
                    Foreground="{ThemeResource AccentBrush}"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <FontIcon x:Name="RightPanelToggleIcon" Glyph="&#xE90D;" FontSize="14" />
                </Button>
                <Button
                    x:Name="CalendarFiltersButton"
                    AutomationProperties.Name="日历显示选项"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <FontIcon x:Name="CalendarFiltersIcon" Glyph="&#xE71C;" FontSize="13" />
                    <Button.Flyout>
                        <MenuFlyout
                            Opening="FiltersFlyout_Opening"
                            Closed="FiltersFlyout_Closed"
                            Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem
                                x:Name="ShowTodosMenuItem"
                                Click="ShowTodos_Click"
                                Text="待办" />
                            <ToggleMenuFlyoutItem
                                x:Name="HideCompletedMenuItem"
                                Click="HideCompleted_Click"
                                Text="已完成待办" />
                            <MenuFlyoutSeparator />
                            <!--  子菜单在展开时按仓库里的日历列表重建，勾选状态与设置页共用  -->
                            <MenuFlyoutSubItem
                                x:Name="CalendarSourcesMenuItem"
                                Text="按日历筛选" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="SyncButton"
                    AutomationProperties.Name="同步日历"
                    Click="SyncButton_Click"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <Grid
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!--  只有这一层参与旋转；提示点在外面，不会跟着转。  -->
                        <Grid
                            x:Name="SyncSpinnerHost"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <FontIcon
                                x:Name="SyncIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Glyph="&#xE895;" />
                        </Grid>
                        <!--  待同步提示点：默认隐藏，有积压时亮橙色，悬停看具体原因。  -->
                        <Border
                            x:Name="SyncPendingDot"
                            Width="7"
                            Height="7"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#F0A030"
                            CornerRadius="4"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>

            <!--  日期切换 + 月/日 + 关闭：靠右  -->
            <StackPanel
                x:Name="NavigationGroup"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    x:Name="MonthNavBar"
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SegmentBarBrush}"
                    BorderBrush="{ThemeResource LayerStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button
                            x:Name="PrevNavButton"
                            Width="26"
                            Height="26"
                            AutomationProperties.Name="上个月"
                            AllowDrop="True"
                            Click="PrevMonth_Click"
                            DragLeave="MonthNav_DragLeave"
                            DragOver="PrevMonth_DragOver"
                            Style="{StaticResource FlatIconButtonStyle}">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                        </Button>
                        <Button
                            x:Name="MonthTitleButton"
                            Height="26"
                            Padding="6,0"
                            AutomationProperties.Name="选择年月"
                            Click="MonthTitle_Click"
                            Style="{StaticResource LinkButtonStyle}">
                            <TextBlock
                                x:Name="MonthTitle"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Button>
                        <Button
                            x:Name="NextNavButton"
                            Width="26"
                            Height="26"
                            AutomationProperties.Name="下个月"
                            AllowDrop="True"
                            Click="NextMonth_Click"
                            DragLeave="MonthNav_DragLeave"
                            DragOver="NextMonth_DragOver"
                            Style="{StaticResource FlatIconButtonStyle}">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                        </Button>
                        <Button
                            Height="26"
                            Padding="8,0"
                            AutomationProperties.Name="回到今天"
                            Click="Today_Click"
                            Style="{StaticResource LinkButtonStyle}"
                            Content="今天" />
                    </StackPanel>
                </Border>
                <Border
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SegmentBarBrush}"
                    BorderBrush="{ThemeResource LayerStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button
                            x:Name="MonthViewButton"
                            Height="26"
                            MinWidth="26"
                            MinHeight="26"
                            Padding="7,2"
                            FontSize="11"
                            AutomationProperties.Name="月视图"
                            Click="MonthView_Click"
                            Style="{StaticResource SegmentButtonStyle}"
                            Content="月" />
                        <Button
                            x:Name="DayViewButton"
                            Height="26"
                            MinWidth="26"
                            MinHeight="26"
                            Padding="7,2"
                            FontSize="11"
                            AutomationProperties.Name="日视图"
                            Click="DayView_Click"
                            Style="{StaticResource SegmentButtonStyle}"
                            Content="日" />
                    </StackPanel>
                </Border>
                <Button
                    x:Name="CloseCalendarButton"
                    AutomationProperties.Name="关闭日窗"
                    Click="CloseCalendar_Click"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="BodyGrid"
            Grid.Row="1"
            Padding="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="260" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="CalendarSurface"
                Grid.Column="1"
                Padding="8"
                Background="{ThemeResource LayerFillSecondaryBrush}"
                BorderBrush="{ThemeResource LayerStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="WeekdayRow" Margin="8,0,8,6" />
                    <!--  月视图滚动时的背景大数字水印（置于网格底层，低透明度不遮挡日程）  -->
                    <StackPanel
                        x:Name="ScrollMonthWatermark"
                        Grid.Row="1"
                        Canvas.ZIndex="-1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Opacity="0.09"
                        Spacing="-14"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ScrollMonthWatermarkMonth"
                            HorizontalAlignment="Center"
                            FontSize="128"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock
                            x:Name="ScrollMonthWatermarkYear"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>

                    <Grid
                        x:Name="DaysGrid"
                        Grid.Row="1"
                        RowSpacing="4"
                        ColumnSpacing="4" />

                    <!--  月视图滚动时浮出的当前年月胶囊，停手后自动消失  -->
                    <Border
                        x:Name="ScrollMonthHintPill"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="14,5,14,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource LayerStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ScrollMonthHintText"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid
                x:Name="RightDrawerHost"
                Grid.Column="0"
                Margin="0,0,10,0">
            <Grid x:Name="RightPanelGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="10,8,10,8"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RightTapped="RightPanel_RightTapped">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock
                                x:Name="SelectedDateText"
                                Margin="0,0,30,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}" />
                            <Button
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="在此日期新建任务"
                                Click="NewTask_Click"
                                Style="{StaticResource FlatIconButtonStyle}">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailsPanel" Padding="0,0,10,0" Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
