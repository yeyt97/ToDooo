<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ToDooo.Helpers"
    xmlns:models="using:ToDooo.Models"
    Title="ToDooo">

    <!-- 所有行/列都用 Auto 与 * ，窗口缩放时列表区自动吃掉剩余高度；最小尺寸同时由 Win32 层约束 -->
    <Grid x:Name="Root" Background="Transparent" MinWidth="320" MinHeight="360">
        <Border
            CornerRadius="{StaticResource CardCornerRadius}"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardStrokeBrush}"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  顶栏：中性图标 + 标题，去掉强调色方块  -->
                <Grid Height="50" Padding="14,0,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="DragRegion"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        PointerCaptureLost="DragRegion_PointerCaptureLost"
                        PointerMoved="DragRegion_PointerMoved"
                        PointerPressed="DragRegion_PointerPressed"
                        PointerReleased="DragRegion_PointerReleased">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border
                                Width="22"
                                Height="22"
                                CornerRadius="7"
                                Background="{StaticResource LayerFillSecondaryBrush}"
                                BorderBrush="{StaticResource LayerStrokeBrush}"
                                BorderThickness="1">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock
                                Text="待办"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Button
                        x:Name="MoreButton"
                        Grid.Column="2"
                        Style="{StaticResource FlatIconButtonStyle}"
                        ToolTipService.ToolTip="更多">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Opening="MoreFlyout_Opening">
                                <ToggleMenuFlyoutItem x:Name="StartupMenuItem" Text="开机自启" Click="StartupMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="退出 ToDooo" Click="ExitMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!--  分段筛选条（DeskBox Segmented）  -->
                <Border
                    Grid.Row="1"
                    Margin="12,0,12,8"
                    Padding="3"
                    Background="{StaticResource SegmentBarBrush}"
                    BorderBrush="{StaticResource LayerStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SegmentCornerRadius}">
                    <Grid ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="AllFilterButton"
                            Grid.Column="0"
                            Style="{StaticResource SegmentButtonStyle}"
                            Click="AllFilter_Click"
                            ToolTipService.ToolTip="显示全部待办">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="全部" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.AllCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ActiveStat"
                            Grid.Column="1"
                            Style="{StaticResource StatButtonStyle}"
                            Click="ActiveFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="进行中" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ImportantStat"
                            Grid.Column="2"
                            Style="{StaticResource StatButtonStyle}"
                            Click="ImportantFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="重要" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ImportantCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DoneStat"
                            Grid.Column="3"
                            Style="{StaticResource StatButtonStyle}"
                            Click="DoneFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="已完成" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.DoneCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  颜色筛选：14x6 短横条  -->
                <StackPanel
                    x:Name="TagPanel"
                    Grid.Row="2"
                    Padding="14,0,14,8"
                    Orientation="Horizontal"
                    Spacing="2" />

                <!--  添加入口：常驻输入框，回车或离焦即提交；右侧清除 + 详细新建  -->
                <Grid
                    x:Name="AddBar"
                    Grid.Row="3"
                    Height="46"
                    Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="4"
                        Background="{StaticResource ItemCardBrush}"
                        BorderBrush="{StaticResource ItemCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ItemCornerRadius}" />
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE710;"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox
                        x:Name="AddTextBox"
                        Grid.Column="1"
                        Height="46"
                        Style="{StaticResource AddTextBoxStyle}"
                        TextChanged="AddTextBox_TextChanged"
                        KeyDown="AddTextBox_KeyDown"
                        LostFocus="AddTextBox_LostFocus" />
                    <Button
                        x:Name="ClearAddButton"
                        Grid.Column="2"
                        Margin="0,0,2,0"
                        Visibility="Collapsed"
                        Style="{StaticResource CardActionButtonStyle}"
                        Click="ClearAddButton_Click"
                        ToolTipService.ToolTip="清除输入">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                    <Button
                        x:Name="AddDetailButton"
                        Grid.Column="3"
                        Margin="0,0,6,0"
                        Style="{StaticResource CardActionButtonStyle}"
                        Click="AddDetailButton_Click"
                        ToolTipService.ToolTip="详细添加（可设置时间、重复、标签）">
                        <FontIcon Glyph="&#xE787;" FontSize="13" />
                    </Button>
                </Grid>

                <!--  卡片式列表  -->
                <Grid Grid.Row="4">
                    <ListView
                        x:Name="TodoList"
                        Padding="12,0,12,0"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="TodoList_DragItemsCompleted"
                        IsItemClickEnabled="True"
                        ItemClick="TodoList_ItemClick"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectionMode="None"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoItem">
                                <Border
                                    Style="{StaticResource TodoCardBorderStyle}"
                                    PointerEntered="TodoCard_PointerEntered"
                                    PointerExited="TodoCard_PointerExited">
                                    <Border.ContextFlyout>
                                        <MenuFlyout Opening="RowFlyout_Opening">
                                            <MenuFlyoutItem Text="编辑…" Click="RowEdit_Click" />
                                            <MenuFlyoutItem Text="标记为重要" Click="RowImportant_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="删除" Click="RowDelete_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            Style="{StaticResource TodoCompletionCheckBoxStyle}"
                                            IsChecked="{x:Bind IsDone, Mode=OneWay}"
                                            Click="DoneCheckBox_Click"
                                            Loaded="DoneCheckBox_Loaded"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="标记完成" />

                                        <Border
                                            Grid.Column="1"
                                            Width="3"
                                            Height="20"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind helpers:Bind.TagBrush(TagIndex), Mode=OneWay}"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind helpers:Bind.HasTag(TagIndex), Mode=OneWay}" />

                                        <StackPanel
                                            Grid.Column="2"
                                            Spacing="3"
                                            VerticalAlignment="Center"
                                            Opacity="{x:Bind helpers:Bind.DoneOpacity(IsDone), Mode=OneWay}">
                                            <TextBlock
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                FontSize="13"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Foreground="{x:Bind helpers:Bind.TitleBrush(IsDone), Mode=OneWay}"
                                                TextDecorations="{x:Bind helpers:Bind.Deco(IsDone), Mode=OneWay}" />
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind helpers:Bind.Visible(DueText), Mode=OneWay}">
                                                <FontIcon
                                                    Glyph="&#xE787;"
                                                    FontSize="10"
                                                    VerticalAlignment="Center"
                                                    Foreground="{x:Bind helpers:Bind.DueBrush(IsOverdue), Mode=OneWay}" />
                                                <TextBlock
                                                    Text="{x:Bind DueText, Mode=OneWay}"
                                                    FontSize="11"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{x:Bind helpers:Bind.DueBrush(IsOverdue), Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--
                                            行尾重要开关：无底板、无描边，就是一个图标按钮。
                                            未标记时悬停才浮现，标记后常亮（Opacity / IsHitTestVisible 跟 IsImportant 走）。
                                        -->
                                        <Button
                                            Grid.Column="3"
                                            Tag="ItemActions"
                                            Style="{StaticResource CardActionButtonStyle}"
                                            Click="QuickImportant_Click"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsHitTestVisible="{x:Bind IsImportant, Mode=OneWay}"
                                            Opacity="{x:Bind helpers:Bind.ImportantOpacity(IsImportant), Mode=OneWay}"
                                            ToolTipService.ToolTip="标记为重要">
                                            <FontIcon
                                                Glyph="{x:Bind helpers:Bind.ImportantGlyph(IsImportant), Mode=OneWay}"
                                                FontSize="13"
                                                Foreground="{x:Bind helpers:Bind.ImportantForeground(IsImportant), Mode=OneWay}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  空状态  -->
                    <StackPanel
                        Margin="0,-24,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind helpers:Bind.VisibleWhen(ViewModel.IsEmpty), Mode=OneWay}">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="28"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}"
                            Opacity="0.6" />
                        <TextBlock
                            Text="还没有待办"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock
                            Text="回车或离焦即保存 · 点右侧日历设置时间 · 点任务编辑详情"
                            FontSize="12"
                            MaxWidth="320"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <!--  底栏：剩余数量 + 清除已完成  -->
                <Grid Grid.Row="5" Padding="14,2,10,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.FooterText, Mode=OneWay}"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextMutedBrush}" />
                    <Button
                        x:Name="ClearCompletedButton"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Click="ClearCompleted_Click"
                        Content="清除已完成"
                        IsEnabled="{x:Bind ViewModel.HasCompleted, Mode=OneWay}"
                        Style="{StaticResource LinkButtonStyle}"
                        ToolTipService.ToolTip="删除所有已完成的待办，不可撤销" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
