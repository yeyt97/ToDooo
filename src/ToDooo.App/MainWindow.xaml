<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ToDooo.Helpers"
    xmlns:models="using:ToDooo.Models"
    xmlns:controls="using:ToDooo.Controls"
    Title="ToDooo">

    <!-- 所有行/列都用 Auto 与 * ，窗口缩放时列表区自动吃掉剩余高度；最小尺寸同时由 Win32 层约束 -->
    <controls:CursorGrid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        MinWidth="320"
        MinHeight="360"
        PointerCaptureLost="Root_PointerCaptureLost"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited">
        <Border
            CornerRadius="0"
            Background="{ThemeResource CardBrush}"
            BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  顶栏：中性图标 + 标题，去掉强调色方块  -->
                <Grid Height="50" Padding="14,0,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="DragRegion"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        PointerCaptureLost="DragRegion_PointerCaptureLost"
                        PointerMoved="DragRegion_PointerMoved"
                        PointerPressed="DragRegion_PointerPressed"
                        PointerReleased="DragRegion_PointerReleased">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border
                                Width="22"
                                Height="22"
                                CornerRadius="7"
                                Background="{ThemeResource LayerFillSecondaryBrush}"
                                BorderBrush="{ThemeResource LayerStrokeBrush}"
                                BorderThickness="1">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock
                                Text="ToDooo"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="2"
                        AutomationProperties.Name="搜索"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Click="SearchButton_Click">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        Grid.Column="3"
                        AutomationProperties.Name="更多"
                        Style="{StaticResource FlatIconButtonStyle}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Opening="MoreFlyout_Opening">
                                <ToggleMenuFlyoutItem x:Name="PinMenuItem" Text="钉在桌面" Click="PinMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="设置…" Click="SettingsMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="退出 ToDooo" Click="ExitMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!--  分段筛选条（DeskBox Segmented）  -->
                <Border
                    Grid.Row="1"
                    Margin="12,0,12,8"
                    Padding="3"
                    Background="{ThemeResource SegmentBarBrush}"
                    BorderBrush="{ThemeResource LayerStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SegmentCornerRadius}">
                    <Grid ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="AllFilterButton"
                            Grid.Column="0"
                            AutomationProperties.Name="全部"
                            Style="{StaticResource SegmentButtonStyle}"
                            Click="AllFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="全部" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.AllCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ActiveStat"
                            Grid.Column="1"
                            AutomationProperties.Name="进行中"
                            Style="{StaticResource StatButtonStyle}"
                            Click="ActiveFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="进行中" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ImportantStat"
                            Grid.Column="2"
                            AutomationProperties.Name="重要"
                            Style="{StaticResource StatButtonStyle}"
                            Click="ImportantFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="重要" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ImportantCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DoneStat"
                            Grid.Column="3"
                            AutomationProperties.Name="已完成"
                            Style="{StaticResource StatButtonStyle}"
                            Click="DoneFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="已完成" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.DoneCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  搜索条：Ctrl+F 展开，Esc 关闭  -->
                <Grid
                    x:Name="SearchBar"
                    Grid.Row="2"
                    Height="34"
                    Margin="12,0,12,8"
                    Visibility="Collapsed">
                    <Border
                        Background="{ThemeResource ItemCardBrush}"
                        BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ItemCornerRadius}" />
                    <Grid Padding="10,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Height="34"
                            AutomationProperties.Name="搜索待办"
                            KeyDown="SearchBox_KeyDown"
                            PlaceholderText="搜索待办"
                            Style="{StaticResource AddTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Grid>

                <!--  智能视图 + 颜色筛选  -->
                <StackPanel
                    Grid.Row="3"
                    Margin="14,0,14,8"
                    Spacing="6">
                    <StackPanel
                        x:Name="SmartViewPanel"
                        Orientation="Horizontal"
                        Spacing="6" />
                    <StackPanel
                        x:Name="TagPanel"
                        Orientation="Horizontal"
                        Spacing="2" />
                </StackPanel>

                <!--  添加入口：常驻输入框，回车或离焦即提交；右侧清除 + 详细新建  -->
                <Grid
                    x:Name="AddBar"
                    Grid.Row="4"
                    Height="46"
                    Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="4"
                        Background="{ThemeResource ItemCardBrush}"
                        BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ItemCornerRadius}" />
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE710;"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBox
                        x:Name="AddTextBox"
                        Grid.Column="1"
                        Height="46"
                        Style="{StaticResource AddTextBoxStyle}"
                        TextChanged="AddTextBox_TextChanged"
                        KeyDown="AddTextBox_KeyDown"
                        LostFocus="AddTextBox_LostFocus" />
                    <Button
                        x:Name="ClearAddButton"
                        Grid.Column="2"
                        AutomationProperties.Name="清除输入"
                        Margin="0,0,2,0"
                        Visibility="Collapsed"
                        Style="{StaticResource CardActionButtonStyle}"
                        Click="ClearAddButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                    <Button
                        x:Name="AddDetailButton"
                        Grid.Column="3"
                        AutomationProperties.Name="详细添加"
                        Margin="0,0,6,0"
                        Style="{StaticResource CardActionButtonStyle}"
                        Click="AddDetailButton_Click">
                        <FontIcon Glyph="&#xE787;" FontSize="13" />
                    </Button>
                </Grid>

                <!--  卡片式列表  -->
                <Grid Grid.Row="5">
                    <ListView
                        x:Name="TodoList"
                        Padding="12,0,12,0"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="TodoList_DragItemsCompleted"
                        DragItemsStarting="TodoList_DragItemsStarting"
                        IsItemClickEnabled="True"
                        ItemClick="TodoList_ItemClick"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectionMode="None"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoItem">
                                <Border
                                    Style="{StaticResource TodoCardBorderStyle}"
                                    PointerEntered="TodoCard_PointerEntered"
                                    PointerExited="TodoCard_PointerExited">
                                    <Border.ContextFlyout>
                                        <MenuFlyout Opening="RowFlyout_Opening">
                                            <MenuFlyoutItem Text="编辑…" Click="RowEdit_Click" />
                                            <MenuFlyoutItem Text="添加子任务…" Click="RowAddSubtask_Click" />
                                            <MenuFlyoutItem Text="10 分钟后再提醒" Click="RowSnooze_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="删除" Click="RowDelete_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid VerticalAlignment="Center" ColumnSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            AutomationProperties.Name="标记完成"
                                            Style="{StaticResource TodoCompletionCheckBoxStyle}"
                                            IsChecked="{x:Bind IsDone, Mode=OneWay}"
                                            Click="DoneCheckBox_Click"
                                            Loaded="DoneCheckBox_Loaded"
                                            VerticalAlignment="Center" />

                                        <Border
                                            Grid.Column="1"
                                            Width="3"
                                            Height="20"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind helpers:Bind.TagBrush(TagIndex), Mode=OneWay}"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind helpers:Bind.HasTag(TagIndex), Mode=OneWay}" />

                                        <StackPanel
                                            Grid.Column="2"
                                            Spacing="3"
                                            VerticalAlignment="Center"
                                            Opacity="{x:Bind helpers:Bind.DoneOpacity(IsDone), Mode=OneWay}">
                                            <TextBlock
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                FontSize="13"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Foreground="{x:Bind helpers:Bind.TitleBrush(IsDone), Mode=OneWay}"
                                                TextDecorations="{x:Bind helpers:Bind.Deco(IsDone), Mode=OneWay}" />
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind helpers:Bind.Visible(DueText), Mode=OneWay}">
                                                <FontIcon
                                                    Glyph="&#xE787;"
                                                    FontSize="10"
                                                    VerticalAlignment="Center"
                                                    Foreground="{x:Bind helpers:Bind.DueBrush(IsOverdue), Mode=OneWay}" />
                                                <TextBlock
                                                    Text="{x:Bind DueText, Mode=OneWay}"
                                                    FontSize="11"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{x:Bind helpers:Bind.DueBrush(IsOverdue), Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  子任务进度跟标题同一行，展开的清单落在第二行  -->
                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="展开子任务"
                                            Margin="2,0,2,0"
                                            Padding="3,2,6,2"
                                            VerticalAlignment="Center"
                                            Click="SubtasksToggle_Click"
                                            Visibility="{x:Bind helpers:Bind.VisibleWhen(HasSubtasks), Mode=OneWay}"
                                            Style="{StaticResource SubtaskToggleStyle}">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="5"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    Width="10"
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Foreground="{ThemeResource TextMutedBrush}"
                                                    Glyph="{x:Bind helpers:Bind.ChevronGlyph(SubtasksExpanded), Mode=OneWay}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextMutedBrush}"
                                                    Text="子任务" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                                    Text="{x:Bind SubtaskProgressText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>

                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Grid.ColumnSpan="3"
                                            Margin="0,2,0,0"
                                            PointerEntered="SubtaskListArea_PointerEntered"
                                            PointerExited="SubtaskListArea_PointerExited"
                                            Visibility="{x:Bind helpers:Bind.VisibleWhen(SubtasksExpanded), Mode=OneWay}">
                                            <ItemsControl
                                                ItemsSource="{x:Bind Subtasks, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SubtaskItem">
                                                        <Grid
                                                            Margin="0,1"
                                                            Background="Transparent"
                                                            ColumnSpacing="4"
                                                            CanDrag="True"
                                                            AllowDrop="True"
                                                            DragStarting="SubtaskRow_DragStarting"
                                                            DragOver="SubtaskRow_DragOver"
                                                            Drop="SubtaskRow_Drop"
                                                            DropCompleted="SubtaskRow_DropCompleted">
                                                            <Grid.ContextFlyout>
                                                                <MenuFlyout Opening="SubtaskFlyout_Opening">
                                                                    <MenuFlyoutItem Text="删除子任务" Click="SubtaskDelete_Click" />
                                                                </MenuFlyout>
                                                            </Grid.ContextFlyout>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox
                                                                AutomationProperties.Name="子任务完成"
                                                                Click="SubtaskCheck_Click"
                                                                IsChecked="{x:Bind IsDone, Mode=OneWay}"
                                                                Style="{StaticResource TodoCompletionCheckBoxStyle}"
                                                                VerticalAlignment="Center" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Text="{x:Bind Title, Mode=OneWay}"
                                                                TextDecorations="{x:Bind helpers:Bind.Deco(IsDone), Mode=OneWay}"
                                                                TextWrapping="Wrap"
                                                                Foreground="{x:Bind helpers:Bind.SubtaskBrush(IsDone), Mode=OneWay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!--
                                            行尾重要开关：无底板、无描边，就是一个图标按钮。
                                            未标记时悬停才浮现，标记后常亮（Opacity / IsHitTestVisible 跟 IsImportant 走）。
                                        -->
                                        <Button
                                            Grid.Column="4"
                                            AutomationProperties.Name="标记为重要"
                                            Tag="ItemActions"
                                            Style="{StaticResource CardActionButtonStyle}"
                                            Click="QuickImportant_Click"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsHitTestVisible="{x:Bind IsImportant, Mode=OneWay}"
                                            Opacity="{x:Bind helpers:Bind.ImportantOpacity(IsImportant), Mode=OneWay}">
                                            <FontIcon
                                                Glyph="{x:Bind helpers:Bind.ImportantGlyph(IsImportant), Mode=OneWay}"
                                                FontSize="13"
                                                Foreground="{x:Bind helpers:Bind.ImportantForeground(IsImportant), Mode=OneWay}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  空状态  -->
                    <StackPanel
                        Margin="0,-24,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind helpers:Bind.VisibleWhen(ViewModel.IsEmpty), Mode=OneWay}">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="28"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Opacity="0.6" />
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                            FontSize="12"
                            MaxWidth="320"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <!--  底栏：清除已完成  -->
                <Grid Grid.Row="6" Padding="14,2,10,10">
                    <Button
                        x:Name="ClearCompletedButton"
                        AutomationProperties.Name="清除已完成"
                        HorizontalAlignment="Right"
                        Click="ClearCompleted_Click"
                        Content="清除已完成"
                        IsEnabled="{x:Bind ViewModel.HasCompleted, Mode=OneWay}"
                        Style="{StaticResource LinkButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <!--  删除/清空后的撤销条，6 秒后自动消失  -->
        <Border
            x:Name="UndoBar"
            Grid.RowSpan="7"
            Margin="12,0,12,10"
            Padding="12,8,10,8"
            VerticalAlignment="Bottom"
            Background="{ThemeResource OverlaySurfaceBrush}"
            BorderBrush="{ThemeResource LayerStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="UndoText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Content="撤销"
                    Click="UndoButton_Click"
                    Style="{StaticResource LinkButtonStyle}" />
            </Grid>
        </Border>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="N"
                Invoked="NewTodoAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="F"
                Invoked="SearchAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number1"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number2"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number3"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number4"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
    </controls:CursorGrid>
</Window>
