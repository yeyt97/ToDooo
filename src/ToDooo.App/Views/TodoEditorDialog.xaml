<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.TodoEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="待办">

    <!--
        独立窗口而不是 ContentDialog：
        ContentDialog 被限制在主窗口客户区里，主窗口一窄就挤成一条、内容显示不全，
        也没法用窗口级亚克力。
    -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="Enter"
                Invoked="SaveAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <!--  自绘标题栏：同时是窗口拖动区，系统关闭按钮叠在右侧  -->
        <Grid
            x:Name="HeaderBar"
            Height="44"
            Padding="18,0,12,0"
            Background="Transparent">
            <TextBlock
                x:Name="HeaderTitle"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="18,2,18,6"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="12">

                <!--  标题  -->
                <TextBox
                    x:Name="TitleBox"
                    MinHeight="40"
                    MaxLength="120"
                    Padding="10,6"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    CornerRadius="6"
                    KeyDown="TitleBox_KeyDown"
                    PlaceholderText="要做什么？"
                    TextWrapping="Wrap" />

                <!--  分组 1：截止时间 + 重复  -->
                <Border
                    Padding="14,10,14,12"
                    Background="{StaticResource ItemCardBrush}"
                    BorderBrush="{StaticResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="截止时间" />
                            <ToggleSwitch
                                x:Name="DueToggle"
                                Grid.Column="1"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                Toggled="DueToggle_Toggled" />
                        </Grid>

                        <StackPanel
                            x:Name="DueSection"
                            Spacing="10"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Width="40"
                                    Style="{StaticResource LabelText}"
                                    Text="日期" />
                                <CalendarDatePicker
                                    x:Name="DueDate"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    PlaceholderText="选择日期" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Width="40"
                                    Style="{StaticResource LabelText}"
                                    Text="时间" />
                                <!--  原生 TimePicker：24 小时制、5 分钟一档  -->
                                <TimePicker
                                    x:Name="DueTime"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ClockIdentifier="24HourClock"
                                    MinuteIncrement="5"
                                    CornerRadius="6" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="重复" />
                            <ComboBox
                                x:Name="RecurrenceBox"
                                Grid.Column="1"
                                Width="150"
                                SelectedIndex="0">
                                <ComboBoxItem Content="不重复" />
                                <ComboBoxItem Content="每天" />
                                <ComboBoxItem Content="每周" />
                                <ComboBoxItem Content="每月" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  分组 2：重要 + 标签  -->
                <Border
                    Padding="14,10,14,12"
                    Background="{StaticResource ItemCardBrush}"
                    BorderBrush="{StaticResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="标记为重要" />
                            <ToggleSwitch
                                x:Name="ImportantToggle"
                                Grid.Column="1"
                                MinWidth="0"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Width="40"
                                Style="{StaticResource LabelText}"
                                Text="标签" />
                            <StackPanel
                                x:Name="TagPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  底部按钮：取消走系统次级样式，保存用系统强调色  -->
        <Grid
            Grid.Row="2"
            Padding="18,10,18,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                MinWidth="88"
                Click="CancelButton_Click"
                Content="取消" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                MinWidth="88"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
