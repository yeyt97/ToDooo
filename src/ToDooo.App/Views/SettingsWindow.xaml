<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置">

    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid
            x:Name="HeaderBar"
            Height="44"
            Padding="18,0,10,0"
            Background="Transparent"
            PointerCaptureLost="HeaderBar_PointerCaptureLost"
            PointerMoved="HeaderBar_PointerMoved"
            PointerPressed="HeaderBar_PointerPressed"
            PointerReleased="HeaderBar_PointerReleased">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimaryBrush}"
                Text="设置" />
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="关闭设置"
                Click="DoneButton_Click"
                Style="{StaticResource FlatIconButtonStyle}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="18,2,18,6"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!--  外观  -->
                <Border
                    Padding="14,10,14,12"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="主题" />
                            <ComboBox
                                x:Name="ThemeBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="深色" />
                                <ComboBoxItem Content="浅色" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="透明度" />
                            <TextBlock
                                x:Name="OpacityValue"
                                Grid.Column="1"
                                MinWidth="36"
                                Style="{StaticResource LabelText}"
                                TextAlignment="Right" />
                        </Grid>
                        <Slider
                            x:Name="OpacitySlider"
                            MinWidth="0"
                            Maximum="0.9"
                            Minimum="0"
                            StepFrequency="0.05"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!--  行为  -->
                <Border
                    Padding="14,10,14,12"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="开机自启" />
                            <ToggleSwitch
                                x:Name="StartupToggle"
                                Grid.Column="1"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                Toggled="StartupToggle_Toggled" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="自动隐藏" />
                            <ToggleSwitch
                                x:Name="AutoHideToggle"
                                Grid.Column="1"
                                MinWidth="0"
                                AutomationProperties.Name="自动隐藏"
                                OffContent=""
                                OnContent=""
                                Toggled="AutoHideToggle_Toggled" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="提前提醒" />
                            <ComboBox
                                x:Name="LeadBox"
                                Grid.Column="1"
                                Width="150"
                                SelectionChanged="LeadBox_SelectionChanged">
                                <ComboBoxItem Content="准时提醒" />
                                <ComboBoxItem Content="提前 5 分钟" />
                                <ComboBoxItem Content="提前 15 分钟" />
                                <ComboBoxItem Content="提前 30 分钟" />
                                <ComboBoxItem Content="提前 1 小时" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="全局呼出" />
                            <ComboBox
                                x:Name="HotkeyBox"
                                Grid.Column="1"
                                Width="150"
                                AutomationProperties.Name="全局呼出快捷键"
                                SelectionChanged="HotkeyBox_SelectionChanged">
                                <ComboBoxItem Content="关闭" />
                                <ComboBoxItem Content="Ctrl + Alt + T" />
                                <ComboBoxItem Content="Ctrl + Shift + T" />
                                <ComboBoxItem Content="Alt + Q" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  智能视图  -->
                <Border
                    Padding="14,10,14,12"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource LabelText}" Text="智能视图" />
                        <TextBlock Style="{StaticResource HintText}" Text="勾选要在主窗口显示的视图，用箭头调整显示顺序。" />
                        <StackPanel x:Name="SmartViewList" Spacing="2" />
                    </StackPanel>
                </Border>

                <!--  颜色标签  -->
                <Border
                    Padding="14,10,14,12"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource LabelText}" Text="颜色标签" />
                        <TextBlock Style="{StaticResource HintText}" Text="为 8 种颜色设置简短分类名（留空则显示默认编号）。" />
                        <Grid x:Name="TagNamesGrid" RowSpacing="6" ColumnSpacing="10" />
                    </StackPanel>
                </Border>

                <!--  数据  -->
                <Border
                    Padding="14,10,14,12"
                    Background="{ThemeResource ItemCardBrush}"
                    BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="ExportButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="ExportButton_Click"
                            Content="导出数据（JSON）…" />
                        <Button
                            x:Name="ImportButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="ImportButton_Click"
                            Content="导入数据（JSON）…" />
                        <Button
                            x:Name="OpenFolderButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OpenFolderButton_Click"
                            Content="打开数据文件夹" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="AboutText"
                    Margin="2,0,2,0"
                    Style="{StaticResource HintText}" />
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Padding="18,10,18,16">
            <Button
                MinWidth="88"
                HorizontalAlignment="Right"
                Click="DoneButton_Click"
                Content="完成"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>