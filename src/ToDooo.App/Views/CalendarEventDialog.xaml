<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.CalendarEventDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="日程">

    <!--
        独立窗口：与待办编辑窗一致，避免 ContentDialog 被主窗客户区挤压。
        版式参考 iOS 日历新建：一块主卡片放标题与时间，下面按「选项 / 详细信息」分组。
    -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="Root_Loaded">
        <Grid.Resources>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="44" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="Margin" Value="16,10,0,6" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="14,10,14,12" />
                <Setter Property="Background" Value="{ThemeResource ItemCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ItemCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="16,0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
            <KeyboardAccelerator Key="Enter" Invoked="SaveAccelerator_Invoked" Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <!--  自绘标题栏  -->
        <Grid
            x:Name="HeaderBar"
            Height="44"
            Padding="16,0,10,0"
            Background="Transparent"
            PointerCaptureLost="HeaderBar_PointerCaptureLost"
            PointerMoved="HeaderBar_PointerMoved"
            PointerPressed="HeaderBar_PointerPressed"
            PointerReleased="HeaderBar_PointerReleased">
            <TextBlock
                x:Name="HeaderTitle"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimaryBrush}" />
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="关闭"
                Click="CancelButton_Click"
                Style="{StaticResource FlatIconButtonStyle}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="0,2,0,4"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <!--  主卡片：标题 + 时间  -->
                <Border Style="{StaticResource Card}" Padding="12,10,14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  左侧日历色条，和月视图里的色条呼应  -->
                        <Border
                            x:Name="ColorStripe"
                            Width="3"
                            CornerRadius="1.5" />

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBox
                                x:Name="TitleBox"
                                MinHeight="38"
                                MaxLength="150"
                                Padding="0,4"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                KeyDown="TitleBox_KeyDown"
                                PlaceholderText="标题"
                                TextWrapping="Wrap" />

                            <Border Height="1" Background="{ThemeResource DividerBrush}" />

                            <!--  开始：标签 + 日期（定宽）+ 时间（占满剩余）  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="开始" />
                                <CalendarDatePicker
                                    x:Name="StartDate"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    Width="132"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="开始日期"
                                    CornerRadius="6"
                                    DateChanged="StartDate_DateChanged"
                                    PlaceholderText="日期" />
                                <TimePicker
                                    x:Name="StartTimePicker"
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="开始时间"
                                    ClockIdentifier="24HourClock"
                                    CornerRadius="6"
                                    Loaded="NativeTimePicker_Loaded"
                                    MinuteIncrement="5"
                                    SelectedTimeChanged="StartTimePicker_SelectedTimeChanged" />
                            </Grid>

                            <!--  结束  -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="结束" />
                                <CalendarDatePicker
                                    x:Name="EndDate"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    Width="132"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="结束日期"
                                    CornerRadius="6"
                                    DateChanged="EndDate_DateChanged"
                                    GotFocus="EndField_GotFocus"
                                    PlaceholderText="日期" />
                                <TimePicker
                                    x:Name="EndTimePicker"
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="结束时间"
                                    ClockIdentifier="24HourClock"
                                    CornerRadius="6"
                                    GotFocus="EndField_GotFocus"
                                    Loaded="NativeTimePicker_Loaded"
                                    MinuteIncrement="5"
                                    SelectedTimeChanged="EndTimePicker_SelectedTimeChanged" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleSwitch
                                    x:Name="AllDayToggle"
                                    MinWidth="0"
                                    AutomationProperties.Name="全天"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="AllDayToggle_Toggled" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="全天" />
                            </StackPanel>

                            <Grid x:Name="RepeatRow" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="重复" />
                                <ComboBox
                                    x:Name="RepeatBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="重复"
                                    SelectionChanged="RepeatBox_SelectionChanged" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeader}" Text="选项" />
                <Border Style="{StaticResource Card}" Padding="14,6,14,6">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextMutedBrush}"
                                Glyph="&#xE787;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="日历" />
                            <ComboBox
                                x:Name="CalendarBox"
                                Grid.Column="2"
                                Width="150"
                                AutomationProperties.Name="所属日历" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextMutedBrush}"
                                Glyph="&#xE72E;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="隐私" />
                            <ComboBox
                                x:Name="ClassBox"
                                Grid.Column="2"
                                Width="150"
                                AutomationProperties.Name="隐私">
                                <ComboBoxItem Content="公开" />
                                <ComboBoxItem Content="私密" />
                                <ComboBoxItem Content="机密" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextMutedBrush}"
                                Glyph="&#xE7C1;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="优先级" />
                            <ComboBox
                                x:Name="PriorityBox"
                                Grid.Column="2"
                                Width="150"
                                AutomationProperties.Name="优先级">
                                <ComboBoxItem Content="无" />
                                <ComboBoxItem Content="高" />
                                <ComboBoxItem Content="中" />
                                <ComboBoxItem Content="低" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource GroupHeader}" Text="详细信息" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <!--  地点：输入自动联想，使用跨窗口 Popup 向下展开，不被窗口底边裁切  -->
                        <Grid>
                            <TextBox
                                x:Name="LocationBox"
                                Padding="10,8,34,8"
                                AutomationProperties.Name="地点"
                                CornerRadius="6"
                                GotFocus="LocationBox_GotFocus"
                                PlaceholderText="地点"
                                PreviewKeyDown="LocationBox_PreviewKeyDown"
                                TextChanged="LocationBox_TextChanged" />
                            <ProgressRing
                                x:Name="PlaceSearchProgress"
                                Width="14"
                                Height="14"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsActive="False"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBox
                            x:Name="NoteBox"
                            MinHeight="56"
                            MaxHeight="96"
                            MaxLength="2000"
                            Padding="10,8"
                            AcceptsReturn="True"
                            AutomationProperties.Name="备注"
                            CornerRadius="6"
                            PlaceholderText="备注"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="UrlBox"
                            Padding="10,8"
                            AutomationProperties.Name="链接"
                            CornerRadius="6"
                            PlaceholderText="URL（可选）" />
                        <TextBox
                            x:Name="CategoryBox"
                            Padding="10,8"
                            AutomationProperties.Name="分类"
                            CornerRadius="6"
                            PlaceholderText="分类，多个用逗号分隔（可选）" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  底部按钮  -->
        <Grid
            Grid.Row="2"
            Padding="16,10,16,14"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                MinWidth="88"
                Click="CancelButton_Click"
                Content="取消" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                MinWidth="88"
                AutomationProperties.Name="创建"
                Click="SaveButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" />
                    <TextBlock Text="创建" />
                </StackPanel>
            </Button>
        </Grid>
        <!-- 跨窗口地点联想浮层：ShouldConstrainToRootBounds=False 允许跳出弹窗底边完整显示 -->
        <Popup
            x:Name="PlaceSuggestionsPopup"
            IsLightDismissEnabled="False"
            ShouldConstrainToRootBounds="False">
            <Border
                x:Name="PlaceSuggestionsCard"
                Padding="4"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView
                    x:Name="PlaceSuggestionsList"
                    MaxHeight="260"
                    IsItemClickEnabled="True"
                    ItemClick="PlaceSuggestionsList_ItemClick"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,7" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="14">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Glyph="{Binding Glyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        MaxLines="1"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextMutedBrush}"
                                        MaxLines="1"
                                        Text="{Binding Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</Window>
