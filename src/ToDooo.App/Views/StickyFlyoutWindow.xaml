<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.StickyFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="便签">

    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        Padding="12">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid x:Name="ContentRoot" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏：左侧颜色标签（或内联搜索框），右侧搜索 + 新建 -->
            <Grid Grid.Row="0" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="TagPanel"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center" />

                <Grid
                    x:Name="SearchBar"
                    Grid.Column="0"
                    Height="30"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Border
                        Background="{ThemeResource ItemCardBrush}"
                        BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8" />
                    <Grid Padding="8,0,4,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="0"
                            Height="30"
                            VerticalContentAlignment="Center"
                            KeyDown="SearchBox_KeyDown"
                            LostFocus="SearchBox_LostFocus"
                            PlaceholderText=""
                            Style="{StaticResource AddTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            x:Name="ClearSearchButton"
                            Grid.Column="1"
                            AutomationProperties.Name="清除搜索"
                            Click="ClearSearch_Click"
                            Style="{StaticResource CardActionButtonStyle}"
                            Visibility="Collapsed">
                            <Grid Width="16" Height="16">
                                <Border
                                    Width="16"
                                    Height="16"
                                    BorderBrush="{ThemeResource TextMutedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                                <FontIcon
                                    Glyph="&#xE711;"
                                    FontSize="7"
                                    Foreground="{ThemeResource TextMutedBrush}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="SearchButton"
                        AutomationProperties.Name="搜索便签"
                        Click="SearchButton_Click"
                        Style="{StaticResource FlatIconButtonStyle}"
                        ToolTipService.ToolTip="搜索便签">
                        <FontIcon Glyph="&#xE721;" FontSize="13" />
                    </Button>
                    <Button
                        x:Name="NewButton"
                        AutomationProperties.Name="新建便签"
                        Click="NewButton_Click"
                        Style="{StaticResource FlatIconButtonStyle}"
                        ToolTipService.ToolTip="新建便签（可拖入颜色）">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="ListPanel" Spacing="6" />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,28"
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextMutedBrush}"
                        Text="还没有便签，点右上角 + 新建一张"
                        Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>

            <!-- 删除便签后的 5 秒撤销条 -->
            <Border
                x:Name="UndoBar"
                Grid.RowSpan="2"
                Margin="0,0,0,2"
                Padding="10,7,8,7"
                VerticalAlignment="Bottom"
                Background="{ThemeResource OverlaySurfaceBrush}"
                BorderBrush="{ThemeResource LayerStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="UndoText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        Content="撤销"
                        Click="UndoDelete_Click"
                        Style="{StaticResource LinkButtonStyle}" />
                </Grid>
            </Border>

            <!-- 颜色拖拽物理动效浮层 -->
            <Canvas
                x:Name="DragCanvas"
                Grid.RowSpan="2"
                IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
