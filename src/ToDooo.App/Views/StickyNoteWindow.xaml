<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.StickyNoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="便签">

    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="StickyIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="StickyEditorTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,2,10,8" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <!-- 滚动条不占版面：便签本来就窄，12px 的滚动条加内边距会吃掉正文宽度 -->
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="Transparent">
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                                <TextBlock
                                    x:Name="PlaceholderTextContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{ThemeResource TextMutedBrush}"
                                    IsHitTestVisible="False"
                                    Opacity="0.7"
                                    Text="{TemplateBinding PlaceholderText}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewNoteAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseNoteAccelerator_Invoked" />
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked" />
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ZoomResetAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Border
            x:Name="SurfaceBorder"
            BorderBrush="{ThemeResource DividerBrush}"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 极简顶栏：新建 + 字数/拖拽区 + 颜色圆点/置顶/更多/关闭 -->
                <Grid
                    x:Name="HeaderBar"
                    Grid.Row="0"
                    Padding="10,0,6,0"
                    Background="Transparent"
                    PointerCaptureLost="HeaderBar_PointerCaptureLost"
                    PointerMoved="HeaderBar_PointerMoved"
                    PointerPressed="HeaderBar_PointerPressed"
                    PointerReleased="HeaderBar_PointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        AutomationProperties.Name="新建便签"
                        Click="NewNoteButton_Click"
                        Style="{StaticResource StickyIconButtonStyle}"
                        ToolTipService.ToolTip="新建便签 (Ctrl+N)">
                        <FontIcon Glyph="&#xE710;" FontSize="12.5" />
                    </Button>

                    <TextBlock
                        x:Name="WordCountText"
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{ThemeResource TextMutedBrush}"
                        IsHitTestVisible="False"
                        Opacity="0.6" />

                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource TextMutedBrush}"
                        IsHitTestVisible="False"
                        Opacity="0" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="ColorButton"
                            AutomationProperties.Name="切换颜色"
                            Style="{StaticResource StickyIconButtonStyle}"
                            ToolTipService.ToolTip="切换便签颜色">
                            <Border
                                x:Name="ColorIndicatorDot"
                                Width="11"
                                Height="11"
                                CornerRadius="6" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel x:Name="ColorSwatchPanel" Orientation="Horizontal" Spacing="8" Padding="2" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            x:Name="PinButton"
                            AutomationProperties.Name="置顶便签"
                            Click="PinButton_Click"
                            Style="{StaticResource StickyIconButtonStyle}"
                            ToolTipService.ToolTip="置顶">
                            <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="12.5" />
                        </Button>

                        <Button
                            AutomationProperties.Name="更多选项"
                            Style="{StaticResource StickyIconButtonStyle}"
                            ToolTipService.ToolTip="更多">
                            <FontIcon Glyph="&#xE712;" FontSize="12.5" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="转为待办" Click="ConvertToTodo_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="便签管理" Click="OpenManager_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8FD;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="删除此便签" Click="DeleteNote_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            AutomationProperties.Name="关闭便签"
                            Click="CloseButton_Click"
                            Style="{StaticResource StickyIconButtonStyle}"
                            ToolTipService.ToolTip="关闭 (Ctrl+W)">
                            <FontIcon Glyph="&#xE711;" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 纯文本编辑区 -->
                <TextBox
                    x:Name="EditorBox"
                    Grid.Row="1"
                    AutomationProperties.Name="便签内容"
                    PlaceholderText="记点什么…"
                    Style="{StaticResource StickyEditorTextBoxStyle}"
                    TextChanged="EditorBox_TextChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
