<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ToDooo.Helpers"
    xmlns:models="using:ToDooo.Models"
    xmlns:controls="using:ToDooo.Controls"
    Title="ToDooo">

    <!-- 所有行/列都用 Auto 与 * ，窗口缩放时列表区自动吃掉剩余高度；最小尺寸同时由 Win32 层约束 -->
    <controls:CursorGrid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        MinWidth="320"
        MinHeight="360"
        PointerCaptureLost="Root_PointerCaptureLost"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited">
        <Border
            CornerRadius="0"
            Background="{ThemeResource CardBrush}"
            BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  顶栏：中性图标 + 标题，去掉强调色方块  -->
                <Grid Height="50" Padding="14,0,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="DragRegion"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        PointerCaptureLost="DragRegion_PointerCaptureLost"
                        PointerMoved="DragRegion_PointerMoved"
                        PointerPressed="DragRegion_PointerPressed"
                        PointerReleased="DragRegion_PointerReleased">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border
                                Width="22"
                                Height="22"
                                CornerRadius="7"
                                Background="{ThemeResource LayerFillSecondaryBrush}"
                                BorderBrush="{ThemeResource LayerStrokeBrush}"
                                BorderThickness="1">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock
                                Text="ToDooo"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Button
                        x:Name="CalendarButton"
                        Grid.Column="2"
                        AutomationProperties.Name="日历"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Click="CalendarButton_Click">
                        <FontIcon Glyph="&#xE787;" FontSize="14" />
                    </Button>
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="3"
                        AutomationProperties.Name="搜索"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Click="SearchButton_Click">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Grid.Column="4"
                        AutomationProperties.Name="设置"
                        Style="{StaticResource FlatIconButtonStyle}"
                        Click="SettingsButton_Click">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </Grid>

                <!--  分段筛选条（DeskBox Segmented）  -->
                <Border
                    Grid.Row="1"
                    Margin="12,0,12,8"
                    Padding="3"
                    Background="{ThemeResource SegmentBarBrush}"
                    BorderBrush="{ThemeResource LayerStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SegmentCornerRadius}">
                    <Grid ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="AllFilterButton"
                            Grid.Column="0"
                            AutomationProperties.Name="全部"
                            Style="{StaticResource SegmentButtonStyle}"
                            Click="AllFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="全部" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.AllCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ActiveStat"
                            Grid.Column="1"
                            AutomationProperties.Name="进行中"
                            Style="{StaticResource StatButtonStyle}"
                            Click="ActiveFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="进行中" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ImportantStat"
                            Grid.Column="2"
                            AutomationProperties.Name="重要"
                            Style="{StaticResource StatButtonStyle}"
                            Click="ImportantFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="重要" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ImportantCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DoneStat"
                            Grid.Column="3"
                            AutomationProperties.Name="已完成"
                            Style="{StaticResource StatButtonStyle}"
                            Click="DoneFilter_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="已完成" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.DoneCount, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  搜索条：Ctrl+F 展开，Esc 关闭  -->
                <Grid
                    x:Name="SearchBar"
                    Grid.Row="2"
                    Height="34"
                    Margin="12,0,12,8"
                    Visibility="Collapsed">
                    <Border
                        Background="{ThemeResource ItemCardBrush}"
                        BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ItemCornerRadius}" />
                    <Grid Padding="10,0,6,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Height="34"
                            AutomationProperties.Name="搜索待办"
                            KeyDown="SearchBox_KeyDown"
                            LostFocus="SearchBox_LostFocus"
                            PlaceholderText="搜索待办"
                            Style="{StaticResource AddTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            x:Name="ClearSearchButton"
                            Grid.Column="2"
                            AutomationProperties.Name="清除搜索"
                            Click="ClearSearch_Click"
                            Style="{StaticResource CardActionButtonStyle}"
                            Visibility="Collapsed">
                            <Grid Width="16" Height="16">
                                <Border
                                    Width="16"
                                    Height="16"
                                    BorderBrush="{ThemeResource TextMutedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                                <FontIcon
                                    Glyph="&#xE711;"
                                    FontSize="7"
                                    Foreground="{ThemeResource TextMutedBrush}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <!--  智能视图 + 颜色筛选，最右是“新建”入口  -->
                <Grid Grid.Row="3" Margin="14,0,14,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <StackPanel
                            x:Name="SmartViewPanel"
                            Orientation="Horizontal"
                            Spacing="6" />
                        <StackPanel
                            x:Name="TagPanel"
                            Orientation="Horizontal"
                            Spacing="2" />
                    </StackPanel>
                    <Button
                        x:Name="AddTaskButton"
                        Grid.Column="1"
                        AutomationProperties.Name="新建待办"
                        Style="{StaticResource FlatIconButtonStyle}"
                        VerticalAlignment="Center"
                        Click="AddTaskButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </Grid>

                <!--  添加入口：常驻输入框，回车或离焦即提交；右侧清除 + 详细新建  -->
                <Grid
                    x:Name="AddBar"
                    Grid.Row="4"
                    Height="46"
                    Margin="12,0,12,8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.ColumnSpan="3"
                        Background="{ThemeResource ItemCardBrush}"
                        BorderBrush="{ThemeResource ItemCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ItemCornerRadius}" />
                    <TextBox
                        x:Name="AddTextBox"
                        Grid.Column="0"
                        Height="46"
                        Margin="12,0,4,0"
                        Style="{StaticResource AddTextBoxStyle}"
                        TextChanged="AddTextBox_TextChanged"
                        KeyDown="AddTextBox_KeyDown"
                        LostFocus="AddTextBox_LostFocus"
                        TextCompositionStarted="AddTextBox_TextCompositionStarted"
                        TextCompositionEnded="AddTextBox_TextCompositionEnded" />
                    <Button
                        x:Name="ClearAddButton"
                        Grid.Column="1"
                        AutomationProperties.Name="清除输入"
                        Margin="0,0,2,0"
                        Visibility="Collapsed"
                        Style="{StaticResource CardActionButtonStyle}"
                        Click="ClearAddButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                    <Button
                        x:Name="AddDetailButton"
                        Grid.Column="2"
                        AutomationProperties.Name="详细添加"
                        Margin="0,0,6,0"
                        Style="{StaticResource CardActionButtonStyle}"
                        Click="AddDetailButton_Click">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                    </Button>
                </Grid>

                <!--  卡片式列表  -->
                <Grid Grid.Row="5">
                    <ListView
                        x:Name="TodoList"
                        Padding="12,0,12,0"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="TodoList_DragItemsCompleted"
                        DragItemsStarting="TodoList_DragItemsStarting"
                        IsItemClickEnabled="True"
                        ItemClick="TodoList_ItemClick"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectionMode="None"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoItem">
                                <Border
                                    Style="{StaticResource TodoCardBorderStyle}"
                                    PointerEntered="TodoCard_PointerEntered"
                                    PointerExited="TodoCard_PointerExited">
                                    <Border.ContextFlyout>
                                        <MenuFlyout Opening="RowFlyout_Opening" Closed="RowFlyout_Closed">
                                            <MenuFlyoutItem Text="编辑…" Click="RowEdit_Click" />
                                            <MenuFlyoutSubItem Text="截止时间">
                                                <MenuFlyoutItem Text="今天" Click="RowDueToday_Click" />
                                                <MenuFlyoutItem Text="明天" Click="RowDueTomorrow_Click" />
                                                <MenuFlyoutItem Text="设置时间…" Click="RowDuePick_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="清除时间" Click="RowDueClear_Click" />
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutSubItem Text="设置颜色" />
                                            <MenuFlyoutItem Text="10 分钟后再提醒" Click="RowSnooze_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="删除" Click="RowDelete_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid VerticalAlignment="Center" ColumnSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            AutomationProperties.Name="标记完成"
                                            Style="{StaticResource TodoCompletionCheckBoxStyle}"
                                            IsChecked="{x:Bind IsDone, Mode=OneWay}"
                                            Click="DoneCheckBox_Click"
                                            Loaded="DoneCheckBox_Loaded"
                                            VerticalAlignment="Center" />

                                        <Border
                                            Grid.Column="1"
                                            Width="3"
                                            Height="20"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind helpers:Bind.TagBrush(TagIndex), Mode=OneWay}"
                                            CornerRadius="1.5"
                                            Visibility="{x:Bind helpers:Bind.HasTag(TagIndex), Mode=OneWay}" />

                                        <StackPanel
                                            Grid.Column="2"
                                            Spacing="3"
                                            VerticalAlignment="Center"
                                            Opacity="{x:Bind helpers:Bind.DoneOpacity(IsDone), Mode=OneWay}">
                                            <Grid Tag="TaskTitleArea" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    Glyph="&#xE735;"
                                                    FontSize="10"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource AccentBrush}"
                                                    Visibility="{x:Bind helpers:Bind.VisibleWhen(IsImportant), Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Tag="TaskTitleText"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    FontSize="13"
                                                    MaxLines="2"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap"
                                                    Foreground="{x:Bind helpers:Bind.TitleBrush(IsDone), Mode=OneWay}"
                                                    TextDecorations="{x:Bind helpers:Bind.Deco(IsDone), Mode=OneWay}" />
                                            </Grid>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind helpers:Bind.Visible(DueText), Mode=OneWay}">
                                                <FontIcon
                                                    Glyph="&#xE787;"
                                                    FontSize="10"
                                                    VerticalAlignment="Center"
                                                    Foreground="{x:Bind helpers:Bind.DueBrush(IsOverdue), Mode=OneWay}" />
                                                <TextBlock
                                                    Text="{x:Bind DueText, Mode=OneWay}"
                                                    FontSize="11"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{x:Bind helpers:Bind.DueBrush(IsOverdue), Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="5"
                                                Visibility="{x:Bind helpers:Bind.Visible(Note), Mode=OneWay}">
                                                <FontIcon
                                                    Glyph="&#xE70B;"
                                                    FontSize="9"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextMutedBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind Note, Mode=OneWay}"
                                                    FontSize="11"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{ThemeResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  子任务进度贴最右，展开的清单落在第二行  -->
                                        <Button
                                            Grid.Column="4"
                                            AutomationProperties.Name="子任务"
                                            Margin="2,0,0,0"
                                            Padding="4,2,6,2"
                                            Tag="SubtaskAddControl"
                                            VerticalAlignment="Center"
                                            Click="SubtaskAddButton_Click"
                                            Loaded="SubtaskAddControl_Loaded"
                                            Style="{StaticResource SubtaskToggleStyle}">
                                            <Grid>
                                                <StackPanel
                                                    Tag="SubtaskProgressView"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind helpers:Bind.VisibleWhen(HasSubtasks), Mode=OneWay}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                                        Text="{x:Bind SubtaskProgressText, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Tag="SubtaskProgressAdd"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                                    Opacity="0"
                                                    Text="子任务" />
                                            </Grid>
                                        </Button>

                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Grid.ColumnSpan="3"
                                            Margin="0,2,0,0"
                                            PointerEntered="SubtaskListArea_PointerEntered"
                                            PointerExited="SubtaskListArea_PointerExited"
                                            Visibility="{x:Bind helpers:Bind.VisibleWhen(SubtasksExpanded), Mode=OneWay}">
                                            <ItemsControl
                                                ItemsSource="{x:Bind Subtasks, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SubtaskItem">
                                                        <Grid
                                                            MinHeight="22"
                                                            Margin="0,1"
                                                            Background="Transparent"
                                                            ColumnSpacing="4"
                                                            CanDrag="True"
                                                            AllowDrop="True"
                                                            DragStarting="SubtaskRow_DragStarting"
                                                            DragOver="SubtaskRow_DragOver"
                                                            Drop="SubtaskRow_Drop"
                                                            DropCompleted="SubtaskRow_DropCompleted"
                                                            PointerEntered="SubtaskRow_PointerEntered"
                                                            PointerExited="SubtaskRow_PointerExited">
                                                            <Grid.ContextFlyout>
                                                                <MenuFlyout Opening="SubtaskFlyout_Opening" Closed="SubtaskFlyout_Closed">
                                                                    <MenuFlyoutItem Text="编辑…" Click="SubtaskEdit_Click" />
                                                                    <MenuFlyoutSeparator />
                                                                    <MenuFlyoutItem Text="删除子任务" Click="SubtaskDelete_Click" />
                                                                </MenuFlyout>
                                                            </Grid.ContextFlyout>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox
                                                                AutomationProperties.Name="子任务完成"
                                                                Click="SubtaskCheck_Click"
                                                                IsChecked="{x:Bind IsDone, Mode=OneWay}"
                                                                Style="{StaticResource TodoCompletionCheckBoxStyle}"
                                                                VerticalAlignment="Center" />
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                                <Grid
                                                                    Tag="SubtaskTextArea"
                                                                    ColumnSpacing="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Tag="SubtaskText"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                                        TextDecorations="{x:Bind helpers:Bind.Deco(IsDone), Mode=OneWay}"
                                                                        TextWrapping="Wrap"
                                                                        Foreground="{x:Bind helpers:Bind.SubtaskBrush(IsDone), Mode=OneWay}" />
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Tag="SubtaskEditButton"
                                                                        Width="18"
                                                                        Height="18"
                                                                        MinWidth="0"
                                                                        MinHeight="0"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        Opacity="0"
                                                                        IsHitTestVisible="False"
                                                                        Style="{StaticResource LinkButtonStyle}"
                                                                        Loaded="TextEditButton_Loaded"
                                                                        Click="TextEditButton_Click">
                                                                        <FontIcon
                                                                            Glyph="&#xE70F;"
                                                                            FontSize="9"
                                                                            Foreground="{ThemeResource TextMutedBrush}" />
                                                                    </Button>
                                                                    <TextBox
                                                                        Grid.Column="0"
                                                                        Grid.ColumnSpan="2"
                                                                        Tag="SubtaskEdit"
                                                                        Height="20"
                                                                        FontSize="12"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="Collapsed"
                                                                        Style="{StaticResource AddTextBoxStyle}"
                                                                        KeyDown="SubtaskEdit_KeyDown"
                                                                        LostFocus="SubtaskEdit_LostFocus"
                                                                        TextChanged="TextEdit_TextChanged"
                                                                        TextCompositionStarted="SubtaskEdit_TextCompositionStarted"
                                                                        TextCompositionEnded="SubtaskEdit_TextCompositionEnded" />
                                                                    <Canvas Grid.Column="0" Grid.ColumnSpan="2">
                                                                        <Button
                                                                            Tag="SubtaskSaveButton"
                                                                            Width="20"
                                                                            Height="20"
                                                                            MinWidth="0"
                                                                            MinHeight="0"
                                                                            Padding="0"
                                                                            Visibility="Collapsed"
                                                                            Style="{StaticResource LinkButtonStyle}"
                                                                            Click="SubtaskSaveButton_Click">
                                                                            <FontIcon
                                                                                Glyph="&#xE73E;"
                                                                                FontSize="9"
                                                                                Foreground="{ThemeResource AccentBrush}" />
                                                                        </Button>
                                                                    </Canvas>
                                                                </Grid>
                                                                <StackPanel
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    Visibility="{x:Bind helpers:Bind.Visible(Note), Mode=OneWay}">
                                                                    <FontIcon
                                                                        Glyph="&#xE70B;"
                                                                        FontSize="8"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{ThemeResource TextMutedBrush}" />
                                                                    <TextBlock
                                                                        Text="{x:Bind Note, Mode=OneWay}"
                                                                        FontSize="10"
                                                                        MaxLines="1"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        Foreground="{ThemeResource TextMutedBrush}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal"
                                                                Spacing="4">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="{x:Bind helpers:Bind.DueBrush(IsOverdue), Mode=OneWay}"
                                                                    Text="{x:Bind DueText, Mode=OneWay}"
                                                                    Visibility="{x:Bind helpers:Bind.Visible(DueText), Mode=OneWay}" />
                                                                <Button
                                                                    AutomationProperties.Name="删除子任务"
                                                                    Width="20"
                                                                    Height="20"
                                                                    MinWidth="0"
                                                                    MinHeight="0"
                                                                    Padding="0"
                                                                    Tag="SubtaskDeleteButton"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="0"
                                                                    IsHitTestVisible="False"
                                                                    Click="SubtaskRowDelete_Click"
                                                                    Style="{StaticResource LinkButtonStyle}">
                                                                    <FontIcon
                                                                        Glyph="&#xE711;"
                                                                        FontSize="8"
                                                                        Foreground="{ThemeResource TextMutedBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid
                                                Margin="0,3,0,0"
                                                ColumnSpacing="4"
                                                Visibility="{x:Bind helpers:Bind.VisibleWhen(SubtaskAddActive), Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextMutedBrush}"
                                                    Glyph="&#xE710;" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Height="26"
                                                    Padding="4,0"
                                                    Margin="0,0,2,0"
                                                    FontSize="12"
                                                    Tag="SubtaskAddBox"
                                                    GotFocus="SubtaskAddBox_GotFocus"
                                                    KeyDown="SubtaskAddBox_KeyDown"
                                                    LostFocus="SubtaskAddBox_LostFocus"
                                                    TextCompositionStarted="AddTextBox_TextCompositionStarted"
                                                    TextCompositionEnded="AddTextBox_TextCompositionEnded"
                                                    PlaceholderText="添加子任务，回车确认"
                                                    Style="{StaticResource AddTextBoxStyle}" />
                                                <Button
                                                    Grid.Column="2"
                                                    AutomationProperties.Name="保存子任务"
                                                    Tag="SubtaskAddCheck"
                                                    Width="20"
                                                    Height="20"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource LinkButtonStyle}"
                                                    Click="SubtaskAddCheck_Click">
                                                    <FontIcon
                                                        Glyph="&#xE73E;"
                                                        FontSize="9"
                                                        Foreground="{ThemeResource AccentBrush}" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!--  行尾重要星标：排在子任务按钮左侧，只跟悬停显隐，不常驻。  -->
                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="标记为重要"
                                            Tag="ItemActions"
                                            Style="{StaticResource CardActionButtonStyle}"
                                            Click="QuickImportant_Click"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsHitTestVisible="False"
                                            Opacity="0">
                                            <FontIcon
                                                Glyph="{x:Bind helpers:Bind.ImportantGlyph(IsImportant), Mode=OneWay}"
                                                FontSize="13"
                                                Foreground="{x:Bind helpers:Bind.ImportantForeground(IsImportant), Mode=OneWay}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  空状态  -->
                    <StackPanel
                        Margin="0,-24,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind helpers:Bind.VisibleWhen(ViewModel.IsEmpty), Mode=OneWay}">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="28"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Opacity="0.6" />
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                            FontSize="12"
                            MaxWidth="320"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>

                <!--  底栏：展开子任务 / 清除已完成  -->
                <Grid Grid.Row="6" Padding="14,2,10,10">
                    <Button
                        x:Name="ToggleSubtasksButton"
                        AutomationProperties.Name="{x:Bind ViewModel.SubtasksToggleText, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        Click="ToggleAllSubtasks_Click"
                        Content="{x:Bind ViewModel.SubtasksToggleText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.HasVisibleSubtasks, Mode=OneWay}"
                        Style="{StaticResource LinkButtonStyle}" />
                    <Button
                        x:Name="ClearCompletedButton"
                        AutomationProperties.Name="清除已完成"
                        HorizontalAlignment="Right"
                        Click="ClearCompleted_Click"
                        Content="清除已完成"
                        IsEnabled="{x:Bind ViewModel.HasCompleted, Mode=OneWay}"
                        Style="{StaticResource LinkButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <!--  删除/清空后的撤销条，6 秒后自动消失  -->
        <Border
            x:Name="UndoBar"
            Grid.RowSpan="7"
            Margin="12,0,12,10"
            Padding="12,8,10,8"
            VerticalAlignment="Bottom"
            Background="{ThemeResource OverlaySurfaceBrush}"
            BorderBrush="{ThemeResource LayerStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="UndoText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Content="撤销"
                    Click="UndoButton_Click"
                    Style="{StaticResource LinkButtonStyle}" />
            </Grid>
        </Border>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="N"
                Invoked="NewTodoAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="F"
                Invoked="SearchAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number1"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number2"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number3"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number4"
                Invoked="FilterAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
    </controls:CursorGrid>
</Window>
