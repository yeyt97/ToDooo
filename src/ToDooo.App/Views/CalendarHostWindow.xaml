<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.CalendarHostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ToDooo.Controls"
    xmlns:views="using:ToDooo.Views"
    Title="日历">

    <controls:CursorGrid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        PointerCaptureLost="Root_PointerCaptureLost"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Border
            CornerRadius="0"
            Background="{ThemeResource CardBrush}"
            BorderThickness="0">
            <Grid x:Name="ContentHost">
                <views:CalendarWindow x:Name="CalendarPane" />
            </Grid>
        </Border>
    </controls:CursorGrid>
</Window>
