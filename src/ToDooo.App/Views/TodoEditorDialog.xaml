<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.TodoEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ToDooo.Controls"
    Title="待办">

    <!--
        独立窗口而不是 ContentDialog：
        ContentDialog 被限制在主窗口客户区里，主窗口一窄就挤成一条、内容显示不全，
        也没法用窗口级亚克力。
    -->
    <!--  根容器可聚焦（不进 Tab 序、不画焦点框），用来在点击空白处时接收焦点、让输入框失焦  -->
    <controls:CursorGrid
        x:Name="Root"
        Background="Transparent"
        IsTabStop="True"
        UseSystemFocusVisuals="False"
        KeyboardAcceleratorPlacementMode="Hidden"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased">
        <Grid.Resources>
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="Margin" Value="16,10,0,6" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="14,10,14,12" />
                <Setter Property="Background" Value="{ThemeResource ItemCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ItemCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="16,0" />
            </Style>

            <!--  标签色点：可聚焦按钮，选中态靠亮描边 + 淡底色  -->
            <Style x:Key="TagRingButton" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="Root"
                                Background="Transparent"
                                CornerRadius="13">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="Enter"
                Invoked="SaveAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <!--  自绘标题栏：同时是窗口拖动区，系统关闭按钮叠在右侧  -->
        <Grid
            x:Name="HeaderBar"
            Height="44"
            Padding="18,0,10,0"
            Background="Transparent"
            PointerCaptureLost="HeaderBar_PointerCaptureLost"
            PointerMoved="HeaderBar_PointerMoved"
            PointerPressed="HeaderBar_PointerPressed"
            PointerReleased="HeaderBar_PointerReleased">
            <TextBlock
                x:Name="HeaderTitle"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimaryBrush}" />
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="关闭"
                Click="CancelButton_Click"
                Style="{StaticResource FlatIconButtonStyle}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="0,2,0,4"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="10">

                <!--  主卡片：标签色竖条 + 标题 / 截止 / 重复  -->
                <Border Style="{StaticResource Card}" Padding="12,4,14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  标签色竖条；没选标签时为灰色  -->
                        <Border
                            x:Name="ColorStripe"
                            Width="3"
                            VerticalAlignment="Stretch"
                            CornerRadius="1.5" />

                        <StackPanel Grid.Column="1" Spacing="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Width="40"
                                    Style="{StaticResource LabelText}"
                                    Text="标题" />
                                <!--  用无边框模板：系统默认模板在 BorderThickness=0 时聚焦下划线仍画在框外，
                                      文字和光标看起来会偏离输入区  -->
                                <TextBox
                                    x:Name="TitleBox"
                                    Grid.Column="1"
                                    MinHeight="40"
                                    MaxLength="120"
                                    VerticalContentAlignment="Center"
                                    Style="{StaticResource AddTextBoxStyle}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    KeyDown="TitleBox_KeyDown"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerBrush}" />

                            <!--  截止开关独占一行；打开后日期时间另起一行，不挤在一起  -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Width="40"
                                    Style="{StaticResource LabelText}"
                                    Text="截止" />
                                <ToggleSwitch
                                    x:Name="DueToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="启用截止时间"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="DueToggle_Toggled" />
                            </Grid>

                            <!--  日期与时间：首列留空，宽度与上面的「截止」标签列相同，控件才能和开关列对齐  -->
                            <Grid
                                x:Name="DueSection"
                                ColumnSpacing="10"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker
                                    x:Name="DueDate"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    Width="132"
                                    AutomationProperties.Name="截止日期"
                                    CornerRadius="6"
                                    PlaceholderText="选择日期" />
                                <!--  原生 TimePicker：24 小时制、5 分钟一档  -->
                                <TimePicker
                                    x:Name="DueTime"
                                    Grid.Column="2"
                                    MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="截止时间"
                                    ClockIdentifier="24HourClock"
                                    CornerRadius="6"
                                    Loaded="NativeTimePicker_Loaded"
                                    MinuteIncrement="5" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Width="40"
                                    Style="{StaticResource LabelText}"
                                    Text="重复" />
                                <ComboBox
                                    x:Name="RecurrenceBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="重复方式"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="不重复" />
                                    <ComboBoxItem Content="每天" />
                                    <ComboBoxItem Content="每周" />
                                    <ComboBoxItem Content="每月" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeader}" Text="选项" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="标记为重要" />
                            <ToggleSwitch
                                x:Name="ImportantToggle"
                                Grid.Column="1"
                                AutomationProperties.Name="标记为重要"
                                MinWidth="0"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Width="40"
                                Style="{StaticResource LabelText}"
                                Text="标签" />
                            <StackPanel
                                x:Name="TagPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource GroupHeader}" Text="详细信息" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Width="40"
                            VerticalAlignment="Top"
                            Margin="0,7,0,0"
                            Style="{StaticResource LabelText}"
                            Text="备注" />
                        <TextBox
                            x:Name="NoteBox"
                            Grid.Column="1"
                            MinHeight="54"
                            MaxHeight="88"
                            MaxLength="1000"
                            Padding="10,6"
                            AcceptsReturn="True"
                            AutomationProperties.Name="备注"
                            FontSize="12"
                            CornerRadius="6"
                            PlaceholderText="备注"
                            TextWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource GroupHeader}" Text="子任务" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Style="{StaticResource LabelText}" Text="进度" />
                            <TextBlock
                                x:Name="SubtaskCountText"
                                HorizontalAlignment="Right"
                                Style="{StaticResource LabelText}"
                                Text="0/0" />
                        </Grid>

                        <StackPanel x:Name="SubtaskPanel" Spacing="2" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="SubtaskInput"
                                MinHeight="34"
                                Padding="8,4"
                                AutomationProperties.Name="新子任务"
                                CornerRadius="6"
                                KeyDown="SubtaskInput_KeyDown"
                                PlaceholderText="添加子任务，回车确认" />
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="34"
                                AutomationProperties.Name="添加子任务"
                                Click="AddSubtask_Click"
                                CornerRadius="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  底部按钮：取消走系统次级样式，保存用系统强调色  -->
        <Grid
            Grid.Row="2"
            Padding="18,10,18,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                MinWidth="88"
                Click="CancelButton_Click"
                Content="取消" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                MinWidth="88"
                AutomationProperties.Name="保存"
                Click="SaveButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" />
                    <TextBlock Text="保存" />
                </StackPanel>
            </Button>
        </Grid>
    </controls:CursorGrid>
</Window>
