<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.CalendarMergeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="合并日历">

    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="Margin" Value="16,10,0,6" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="14,10,14,12" />
                <Setter Property="Background" Value="{ThemeResource ItemCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ItemCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="16,0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!--  自绘标题栏  -->
        <Grid
            x:Name="HeaderBar"
            Height="44"
            Padding="18,0,10,0"
            Background="Transparent"
            PointerCaptureLost="HeaderBar_PointerCaptureLost"
            PointerMoved="HeaderBar_PointerMoved"
            PointerPressed="HeaderBar_PointerPressed"
            PointerReleased="HeaderBar_PointerReleased">
            <TextBlock
                x:Name="HeaderTitle"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimaryBrush}"
                Text="合并本地日历" />
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="关闭"
                Click="CancelButton_Click"
                Style="{StaticResource FlatIconButtonStyle}">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="0,2,0,4"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <!--  第一步：说明口径  -->
                <StackPanel x:Name="StepChoose">
                    <TextBlock Style="{StaticResource GroupHeader}" Text="本地日历" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource LabelText}"
                                TextWrapping="Wrap"
                                Text="本机已有日程，需要先决定它们的去处。同一日程在云端已存在时，以云端版本为准，本地版本不会覆盖云端。" />
                            <StackPanel x:Name="ChoiceList" Spacing="2" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  第二步：执行中  -->
                <StackPanel x:Name="StepProgress" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="ProgressText"
                                Style="{StaticResource LabelText}"
                                Text="正在合并…" />
                            <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  第三步：结果  -->
                <StackPanel x:Name="StepResult" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupHeader}" Text="合并结果" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="ResultSummary"
                                Style="{StaticResource LabelText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource LabelText}"
                                FontSize="11"
                                Foreground="{ThemeResource TextMutedBrush}"
                                Text="下面是发生变化的日期，点开可以看到具体日程。" />
                            <StackPanel x:Name="ResultDays" Spacing="2" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  底部按钮  -->
        <Grid
            Grid.Row="2"
            Padding="18,10,18,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CancelButton"
                HorizontalAlignment="Left"
                Content="取消"
                Click="CancelButton_Click" />
            <Button
                x:Name="ConfirmButton"
                Grid.Column="1"
                Style="{StaticResource AccentButtonStyle}"
                Click="ConfirmButton_Click">
                <TextBlock x:Name="ConfirmButtonText" Text="开始合并" />
            </Button>
        </Grid>
    </Grid>
</Window>
