<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ToDooo.Views.CalendarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ToDooo.Controls"
    Title="日历">

    <controls:CursorGrid
        x:Name="Root"
        MinWidth="640"
        MinHeight="440"
        Background="Transparent"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        PointerCaptureLost="Root_PointerCaptureLost"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited"
        SizeChanged="Root_SizeChanged"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderBar"
            Padding="16,0,10,0"
            Background="Transparent"
            PointerCaptureLost="HeaderBar_PointerCaptureLost"
            PointerMoved="HeaderBar_PointerMoved"
            PointerPressed="HeaderBar_PointerPressed"
            PointerReleased="HeaderBar_PointerReleased">
            <TextBlock
                x:Name="HeaderTitleText"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimaryBrush}"
                Text="日历" />

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    AutomationProperties.Name="上个月"
                    Click="PrevMonth_Click"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <TextBlock
                    x:Name="MonthTitle"
                    Width="96"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextPrimaryBrush}" />
                <Button
                    AutomationProperties.Name="下个月"
                    Click="NextMonth_Click"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
                <Button
                    AutomationProperties.Name="回到今天"
                    Click="Today_Click"
                    Style="{StaticResource LinkButtonStyle}"
                    Content="今天" />
                <Button
                    AutomationProperties.Name="关闭日历"
                    Click="CloseButton_Click"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="12,0,12,12"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="260" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="WeekdayRow" Margin="2,0,2,0" />
                <Grid x:Name="DaysGrid" Grid.Row="1" Margin="0,4,0,0" />
            </Grid>

            <Border
                Grid.Column="1"
                Width="1"
                Margin="0,2,0,2"
                Background="{ThemeResource LayerStrokeBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        x:Name="SelectedDateText"
                        Margin="0,0,32,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="在此日期新建任务"
                        Click="NewTask_Click"
                        Style="{StaticResource FlatIconButtonStyle}">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsPanel" Spacing="4" />
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{ThemeResource LayerStrokeBrush}" />

                <Border
                    x:Name="UndatedDropZone"
                    Grid.Row="3"
                    Grid.RowSpan="2"
                    Background="Transparent"
                    AllowDrop="True"
                    DragOver="UndatedDropZone_DragOver"
                    DragLeave="UndatedDropZone_DragLeave"
                    Drop="UndatedDropZone_Drop"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Margin="0,10,0,2"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="UndatedHeaderText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="无截止日期" />
                            <TextBlock
                                x:Name="UndatedCountText"
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="{ThemeResource TextMutedBrush}" />
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="UndatedPanel" Spacing="4" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </controls:CursorGrid>
</Window>