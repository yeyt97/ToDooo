<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ToDooo.Views.TodoEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑待办"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Name="TitleBox" Header="标题" MaxLength="120" PlaceholderText="要做什么？" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker x:Name="DueDate" Header="截止日期" PlaceholderText="不设置" />
            <TimePicker x:Name="DueTime" Grid.Column="1" Header="时间" ClockIdentifier="24HourClock" MinuteIncrement="5" />
        </Grid>

        <ComboBox x:Name="RecurrenceBox" Header="重复" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="不重复" />
            <ComboBoxItem Content="每天" />
            <ComboBoxItem Content="每周" />
            <ComboBoxItem Content="每月" />
        </ComboBox>

        <ToggleSwitch x:Name="ImportantSwitch" Header="重要" OnContent="是" OffContent="否" />

        <StackPanel Spacing="6">
            <TextBlock Text="标签" FontSize="12" Opacity="0.7" />
            <StackPanel x:Name="TagPanel" Orientation="Horizontal" Spacing="10" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
